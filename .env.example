# PocketSmart AI Environment Configuration
# Add your Google AI Studio API key here
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended Gemini Model (gemini-3.8-flash or gemini-2.5-flash)
GEMINI_MODEL=gemini-3.8-flash

# Secret key for JWT session hashing (generate a secure random 32+ character string)
SECRET_KEY=pocketsmart_ai_super_secret_jwt_key_2026_change_in_production

# JWT algorithm
ALGORITHM=HS256

# Token expiration in minutes (default 24 hours = 1440)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
